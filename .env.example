
# Environment Configuration for Load Tests

# Target Host
TARGET_HOST=http://localhost:8080

# gRPC Configuration
GRPC_HOST=localhost
GRPC_PORT=50051

# Test Configuration
LOCUST_USERS=100
LOCUST_SPAWN_RATE=10
LOCUST_RUN_TIME=5m

# SLA Thresholds
LOCUST_P99=1000
LOCUST_P95=500
LOCUST_MAX_FAIL_RATIO=0.01

# Database Configuration (if needed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb

# AWS Configuration (if needed)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Kafka Configuration (if needed)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=test-topic

# Sample service under test
SAMPLE_SERVICE_HOST=https://api.example.com
SAMPLE_SERVICE_TOKEN=

# user-profile (via api-gateway, QA)
# Falls back to BACKEND_API_BASE if USER_PROFILE_BASE_URL is unset
USER_PROFILE_BASE_URL=
USER_PROFILE_PATH_PREFIX=
USER_PROFILE_SEED_CSV=test_data/user_profile_qa_users.csv
USER_PROFILE_SLO_P95_MS=200
USER_PROFILE_SLO_P99_MS=500

# Read-only database used to seed the user pool. Optional: the suite runs
# without it using the CSV in test_data/.
# If you reach your database through a local tunnel or proxy, point this at the
# forwarded port.
DB_DSN_USER_PROFILE=
# QA_DB_URL=postgresql://readonly_user:pass@qa-pg.example.com:5432/appdb

# ── Monitoring stack ──────────────────────────────────────────────────────
# Grafana admin login for docker-compose.monitoring.yml. No default; the
# compose file fails to start rather than booting with a known password.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
