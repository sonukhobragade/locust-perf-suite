      "type": "table",
      "title": "Pod Health Snapshot",
      "gridPos": {
        "x": 0,
        "y": 120,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "avg by (pod) (up{application=\"$application\"})"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "100 * sum by (pod) (jvm_memory_used_bytes{application=\"$application\",area=\"heap\"}) / clamp_min(sum by (pod) (jvm_memory_max_bytes{application=\"$application\",area=\"heap\"} > 0), 1)"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "100 * avg by (pod) (process_cpu_usage{application=\"$application\"})"
