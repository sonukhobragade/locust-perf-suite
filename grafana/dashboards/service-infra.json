        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (rate(jvm_gc_pause_seconds_sum{application=\"$application\"}[5m])) / clamp_min(sum by (action) (rate(jvm_gc_pause_seconds_count{application=\"$application\"}[5m])), 0.001)",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
